<Window x:Class="PuterScanny.App.LocalAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PuterScanny.App.ViewModels"
        Icon="/Assets/PuterScanny.ico"
        Title="Local AI" Width="780" Height="720" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,8,0,0" Click="Close_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Local AI" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,4"
                           Text="A free AI model that runs on this PC. It's downloaded once, then works offline: nothing about your files is sent anywhere, and there's no account, key or cost." />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap">
                    <Run Text="It's used for three things:" /><LineBreak />
                    <Run Text="•  working out questions in Ask that the app can't read on its own" /><LineBreak />
                    <Run Text="•  adding a short summary on top of an answer" /><LineBreak />
                    <Run Text="•  explaining files the app's own rules can't identify" /><LineBreak />
                    <Run Text="It never decides what's safe to delete: recommendations always come from the scan." />
                </TextBlock>

                <!-- On/off and status -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Enabled}" Content="Use the local AI automatically, only when it helps" FontWeight="SemiBold"
                                  AutomationProperties.Name="Use the local AI automatically" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="28,2,0,0" TextWrapping="Wrap"
                                   Text="Questions the app reads with confidence are answered straight from the scan. The AI steps in only to work out questions the app isn't sure about, and, on a fast enough PC, to add a short checked summary. How much it's used depends on this PC's free memory, speed and power." />
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CapacityText}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}"
                                   Visibility="{Binding CapacityText, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                   Text="It runs on the processor, not the graphics card: a quarter of it with &quot;Go easy on this PC&quot; ticked, otherwise half. The model needs about 4 GB of free memory while loaded." />
                        <CheckBox IsChecked="{Binding AutoExplain}" Margin="0,12,0,0" IsEnabled="{Binding Enabled}"
                                  Content="Explain unidentified items automatically when I select them" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="28,2,0,0"
                                   Text="Only on a PC fast enough for it. Otherwise use the item's &quot;Explain with local AI&quot; button." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Free its memory now" Command="{Binding FreeMemoryCommand}" Margin="0,0,8,0"
                                    ToolTip="Unloads the model. It loads again the next time an explanation is needed." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Models -->
                <TextBlock Text="Model" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8" />
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModelRow}">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="{Binding DownloadLabel}" Style="{DynamicResource AccentButtonStyle}" MinWidth="140" Margin="0,0,0,6"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Use this model" MinWidth="140" Margin="0,0,0,6"
                                                Command="{Binding DataContext.UseModelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanUse, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Delete from this PC" MinWidth="140"
                                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Download progress -->
                <Border Style="{StaticResource Card}" Visibility="{Binding DownloadText, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DownloadText}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="Pause" Command="{Binding CancelDownloadCommand}" Margin="12,0,0,0" />
                            <ProgressBar Height="6" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Own model -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Use a model file you already have (advanced)" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   Text="Any instruct-tuned GGUF model works, for example from LM Studio or Ollama's downloads. Only use files from sources you trust." />
                        <TextBlock Text="{Binding CustomModelText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Choose a .gguf file…" Command="{Binding ChooseOwnModelCommand}" Margin="0,0,8,0" />
                            <Button Content="Stop using it" Command="{Binding StopUsingOwnModelCommand}" Margin="0,0,8,0" />
                            <Button Content="Open models folder" Command="{Binding OpenModelsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Batch -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Explain the current scan" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   Text="Writes explanations for the 50 biggest items (over 1 MB) that the scan couldn't identify, so they're ready when you look. Each takes a few seconds to half a minute." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Explain the biggest unidentified items" Command="{Binding ExplainBiggestCommand}" Margin="0,0,8,0" />
                            <Button Content="Stop" Command="{Binding StopBatchCommand}"
                                    Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BatchText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding BatchText, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Scan something first."
                                   Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Saved -->
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Forget saved explanations" Command="{Binding ClearSavedCommand}" />
                    <TextBlock Text="{Binding CacheText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
