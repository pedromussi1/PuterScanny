<Window x:Class="PuterScanny.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PuterScanny.App.ViewModels"
        xmlns:ctrl="clr-namespace:PuterScanny.App.Controls"
        Icon="/Assets/PuterScanny.ico"
        Title="PuterScanny"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="ResultsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
        </Style>
        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailRow}">
                                            <StackPanel>
                                                <!-- Section header -->
                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6"
                                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Label + value (normal or warning) -->
                                                <StackPanel Margin="0,0,0,8" Visibility="{Binding IsRow, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Margin="0,0,4,0" FontSize="12"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" />
                                                </StackPanel>
                                                <!-- Note -->
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,8"
                                                           Style="{StaticResource Muted}"
                                                           Visibility="{Binding IsNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
        <DataTemplate x:Key="AiBlockTemplate" DataType="{x:Type vm:AiExplainBlock}">
            <Border Margin="0,4,0,10" Padding="12,10" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE82F;" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="What it probably is (local AI)" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Padding="0" MinHeight="0" AutomationProperties.Name="AI explanation"
                             Visibility="{Binding Text, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontStyle="Italic" Style="{StaticResource Muted}"
                               Visibility="{Binding Status, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Explain with local AI" Command="{Binding ExplainCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanAsk, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Set up local AI…" Click="OpenLocalAi_Click"
                                Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Credit}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Muted}"
                               Visibility="{Binding Credit, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ChatItemTemplate" DataType="{x:Type vm:ChatItemRow}">
            <Border Margin="0,4,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="0,0,10,0" ToolTip="{Binding Path}" />
                            <TextBlock Text="{Binding SizeText}" Margin="0,0,10,0" />
                            <Border CornerRadius="3" Padding="6,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{Binding VerdictTag, Converter={StaticResource VerdictBrush}}"
                                    Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding VerdictText}" FontSize="11" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding Note}" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Headline}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Headline, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CheckBox Content="In clean-up basket" IsChecked="{Binding BasketRow.IsChecked}" Margin="0,0,10,0" MinWidth="0"
                                  ToolTip="Ticks it in the Clean up tab. Nothing is removed until you press Clean up selected there and confirm."
                                  Visibility="{Binding CanBasket, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Why?" Command="{Binding AskAboutCommand}" Margin="0,0,6,0" Padding="8,2" FontSize="12"
                                ToolTip="Ask what this is and why PuterScanny recommends what it does" />
                        <Button Content="Show in Folders" Command="{Binding ShowCommand}" Margin="0,0,6,0" Padding="8,2" FontSize="12"
                                Visibility="{Binding CanShow, Converter={StaticResource BoolToVisibility}}" />
                        <Button Command="{Binding RevealCommand}" Padding="6,2" ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer"
                                Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC50;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BarRowTemplate" DataType="{x:Type vm:BarRow}">
            <Grid Margin="0,0,0,8" ToolTip="{Binding Path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Grid.Row="1" Height="4" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,3,0,2" VerticalAlignment="Top" />
                <TextBlock Grid.Row="1" Text="{Binding Note}" FontSize="11.5" Style="{StaticResource Muted}" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <ToggleButton x:Name="ThemeToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,5"
                              Click="ThemeToggle_Click" AutomationProperties.Name="Dark mode" ToolTip="Switch between light and dark">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeIcon" FontFamily="{StaticResource IconFont}" Text="&#xE708;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Dark mode" />
                    </StackPanel>
                </ToggleButton>
                <Button DockPanel.Dock="Right" Click="OpenLocalAi_Click" VerticalAlignment="Center" AutomationProperties.Name="Local AI"
                        ToolTip="Free, offline AI that explains items PuterScanny's rules can't identify.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE82F;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Local AI" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/PuterScanny.ico" Width="30" Height="30" Margin="0,2,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PuterScanny" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}"
                       Text="Scan a drive or folder and see everything in it: what each file is, which program it belongs to, and whether to keep it." />
        </StackPanel>

        <!-- What to scan -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Drive" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                              DisplayMemberPath="Display" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                              AutomationProperties.Name="Drive to scan" />
                    <TextBox Grid.Column="2" Margin="8,0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Folder to scan" />
                    <Button Grid.Column="3" Content="Choose folder…" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Command="{Binding StartScanCommand}" MinWidth="96"
                            Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Scan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Content="Stop" Command="{Binding CancelScanCommand}" Margin="8,0,0,0" ToolTip="Stops now. Progress is saved; scan the same place again to continue."
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding LookInsideFiles}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                  Content="Look inside every file (slower, much more detail)" Margin="0,0,24,0"
                                  ToolTip="Opens each file to learn what it really is, and checks the publisher and digital signature of programs. Nothing is changed." />
                        <CheckBox IsChecked="{Binding DeepScan}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                  Content="Deep scan (administrator)" Margin="0,0,24,0" AutomationProperties.Name="Deep scan"
                                  ToolTip="Reads the drive's file table directly as administrator: every corner (even System Volume Information), exact sizes, hard links counted once, plus Windows' records of how often each program ran. Windows will ask for permission." />
                        <CheckBox IsChecked="{Binding GoEasy}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                  Content="Go easy on this PC (recommended)" Margin="0,0,24,0"
                                  ToolTip="Checks fewer files at once, at low disk priority and a capped speed, so antivirus and drivers are never overloaded. A full drive takes much longer (a couple of hours for a large C: drive); untick it for a faster but heavier check. If the check is interrupted, scanning the same place again lets you continue where it stopped." />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Text="{Binding ElevationText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Live progress -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StageText}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" />
                </DockPanel>
                <ProgressBar Margin="0,8" Height="6" Maximum="100"
                             Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="{Binding ProgressStats}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="12"
                           Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding AnalysisNote}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}"
                               Visibility="{Binding AnalysisNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExportButton" Click="ExportButton_Click" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Export report">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDE1;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Export report" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Report as a web page (.html)" Command="{Binding ExportCommand}" CommandParameter="html" />
                                <MenuItem Header="Every file and folder as a spreadsheet (.csv)" Command="{Binding ExportCommand}" CommandParameter="csv" />
                                <MenuItem Header="Report as data (.json)" Command="{Binding ExportCommand}" CommandParameter="json" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Open saved scans" Command="{Binding OpenScansFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <TabControl x:Name="ResultsTabs" Grid.Row="4" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,8,16">
                        <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="Key numbers">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatCard}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10" MinWidth="170">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Where the space goes" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6" />
                        <ctrl:ProportionBar Height="22" Segments="{Binding VerdictSegments}" AutomationProperties.Name="Space by recommendation" />
                        <ItemsControl ItemsSource="{Binding VerdictLegend}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LegendItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{Binding Fill}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Biggest things you can clean" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TopCleanup}" ItemTemplate="{StaticResource BarRowTemplate}" />
                                    <TextBlock Text="Nothing here is clearly safe to remove." Style="{StaticResource Muted}"
                                               Visibility="{Binding TopCleanup.Count, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="What takes the most space" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TopFolders}" ItemTemplate="{StaticResource BarRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="By kind of file" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TopKinds}" ItemTemplate="{StaticResource BarRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Good to know" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding HeadsUp}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Muted}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AskTabItem" Header="Ask" AutomationProperties.Name="Ask about this scan">
                <Grid Margin="0,8,0,0" DataContext="{Binding Chat}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- What the questions are about -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Clear chat" Command="{Binding ClearChatCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Ask about the whole scan" Command="{Binding AskAboutWholeScanCommand}"
                                Visibility="{Binding IsScoped, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="Asking about" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding ScopeText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </DockPanel>

                    <!-- The conversation -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Margin="4,8,4,12" Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Ask about this scan" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}"
                                               Text="Ask what's taking space, what can go, what something is, or why PuterScanny recommends what it does. Answers come from this scan, on this PC: nothing is sent anywhere, and nothing is deleted from here." />
                                </StackPanel>
                                <ItemsControl x:Name="ChatMessages" ItemsSource="{Binding Messages}" AutomationProperties.Name="Conversation">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChatMessage}">
                                            <StackPanel Margin="0,6">
                                                <!-- The question -->
                                                <Border HorizontalAlignment="Right" MaxWidth="640" CornerRadius="10" Padding="12,8"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                                <!-- The answer -->
                                                <Border HorizontalAlignment="Left" MaxWidth="1000" CornerRadius="10" Padding="12,10" BorderThickness="1"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{Binding IsAnswer, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                                 Background="Transparent" Padding="0" MinHeight="0" AutomationProperties.Name="Answer"
                                                                 Visibility="{Binding Text, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding Status}" FontStyle="Italic" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0" ItemTemplate="{StaticResource ChatItemTemplate}" />
                                                        <TextBlock Text="{Binding Credit}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}"
                                                                   Visibility="{Binding Credit, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Suggested questions -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Suggestions}" Margin="0,8,0,0" AutomationProperties.Name="Suggested questions">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,6,6" Padding="10,3" FontSize="12"
                                        Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The question box -->
                    <DockPanel Grid.Row="3" Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Command="{Binding AskCommand}" Margin="8,0,0,0" MinWidth="88"
                                Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Ask">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE725;" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Ask" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="ChatInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Your question">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <DockPanel Grid.Row="4" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Set up local AI…" Click="OpenLocalAi_Click" Margin="8,0,0,0" FontSize="12"
                                Visibility="{Binding ShowAiSetup, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding AiNote}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Treemap">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding TreemapUpCommand}" Margin="0,0,8,0" ToolTip="Up one folder" AutomationProperties.Name="Up one folder">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74A;" />
                        </Button>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding TreemapByKind}" Content="Colour by kind of file" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Crumb}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Name}" Padding="6,2" Margin="0,0,2,0"
                                                Command="{Binding DataContext.TreemapGoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="›" VerticalAlignment="Center" Margin="2,0,4,0" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TreemapLegend}" Margin="0,8,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LegendItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                    <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{Binding Fill}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="380" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                            <ctrl:TreemapControl x:Name="Treemap" Nodes="{Binding TreemapNodes}" Selected="{Binding TreemapSelected, Mode=TwoWay}"
                                                 Opened="Treemap_Opened" AutomationProperties.Name="Treemap of the scanned area" />
                        </Border>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding TreemapTitle}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Box size = space used. Click a box for details; double-click a folder to go inside." />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Ask about this" Command="{Binding AskAboutTreemapSelectedCommand}" Margin="0,0,8,0"
                                            ToolTip="Opens the Ask tab with questions about this folder (or about this file)"
                                            Visibility="{Binding TreemapSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Explain with local AI" Command="{Binding TreemapAi.ExplainCommand}"
                                            Visibility="{Binding TreemapAi.ShowAskButton, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ContentControl Content="{Binding TreemapAi}" ContentTemplate="{StaticResource AiBlockTemplate}" Focusable="False" />
                                        <ItemsControl ItemsSource="{Binding TreemapDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="FoldersTabItem" Header="Folders">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="440" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <TreeView x:Name="FolderTree" Grid.Column="0" ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Folder tree, biggest first">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ProtectionGlyph}" FontSize="12" Margin="6,0,0,0"
                                               VerticalAlignment="Center" ToolTip="{Binding ProtectionTip}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding HasProtection, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <ProgressBar Width="60" Height="4" Margin="10,0,6,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 VerticalAlignment="Center" Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="42" />
                                    <Border CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{Binding VerdictTag, Converter={StaticResource VerdictBrush}}"
                                            Visibility="{Binding HasVerdictTag, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding VerdictTag}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding ReclaimText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{Binding Source=Delete, Converter={StaticResource VerdictBrush}}"
                                               Visibility="{Binding HasReclaim, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding HintText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                           Text="What it is, whether to keep it, and why." />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Show in File Explorer" Command="{Binding OpenInExplorerCommand}" Margin="0,0,8,0" />
                                <Button Content="Ask about this" Command="{Binding AskAboutSelectedCommand}" Margin="0,0,8,0"
                                        ToolTip="Opens the Ask tab with questions about this folder (or about this file)" />
                                <Button Content="Explain with local AI" Command="{Binding FolderAi.ExplainCommand}"
                                        Visibility="{Binding FolderAi.ShowAskButton, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ContentControl Content="{Binding FolderAi}" ContentTemplate="{StaticResource AiBlockTemplate}" Focusable="False" />
                                    <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Clean up">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="{Binding CleanupHeadline}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CleanupDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Tick what you want gone, then press Clean up selected. Everything goes to the Recycle Bin or PuterScanny's quarantine, so it can be undone. Double-click an item to see it in File Explorer." />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,8,0,8" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CleanUpSelectedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"
                                    AutomationProperties.Name="Clean up selected">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Clean up selected…" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Select all recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,6,0" />
                                <Button Content="Select everything in Delete" Command="{Binding SelectAllDeletableCommand}" Margin="0,0,6,0" />
                                <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding BasketText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TabControl>
                        <TabItem Header="{Binding DeletableHeader}">
                        <DataGrid ItemsSource="{Binding DeletableItems}" Style="{StaticResource ResultsGrid}" Margin="0,8,0,0" AutomationProperties.Name="Items to delete"
                                  MouseDoubleClick="CleanupRow_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="150" />
                                <DataGridTextColumn Header="Sure" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="55" />
                                <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="3*" />
                                <DataGridTextColumn Header="What" Binding="{Binding Kind}" Width="*" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding ReviewHeader}">
                        <DataGrid ItemsSource="{Binding ReviewItems}" Style="{StaticResource ResultsGrid}" Margin="0,8,0,0" AutomationProperties.Name="Items to review"
                                  MouseDoubleClick="CleanupRow_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="150" />
                                <DataGridTextColumn Header="Sure" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="55" />
                                <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="3*" />
                                <DataGridTextColumn Header="What" Binding="{Binding Kind}" Width="*" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding ToolHeader}">
                        <DataGrid ItemsSource="{Binding ToolItems}" Style="{StaticResource ResultsGrid}" Margin="0,8,0,0" AutomationProperties.Name="Space to free with Windows tools"
                                  MouseDoubleClick="CleanupRow_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="150" />
                                <DataGridTextColumn Header="Sure" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="55" />
                                <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="3*" />
                                <DataGridTextColumn Header="What" Binding="{Binding Kind}" Width="*" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding UninstallHeader}">
                            <DataGrid ItemsSource="{Binding UninstallItems}" Style="{StaticResource ResultsGrid}" Margin="0,8,0,0" AutomationProperties.Name="Programs to consider uninstalling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                                    <DataGridTextColumn Header="Sure" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="55" />
                                    <DataGridTextColumn Header="Last used" Binding="{Binding LastUsed}" Width="160" />
                                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="4*" />
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding DuplicatesHeader}">
                            <DataGrid ItemsSource="{Binding Duplicates}" Style="{StaticResource ResultsGrid}" Margin="0,8,0,0" AutomationProperties.Name="Duplicate files">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Copy to keep" Binding="{Binding Keep}" Width="3*" />
                                    <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="65" />
                                    <DataGridTextColumn Header="Each" Binding="{Binding SizeText}" Width="80" />
                                    <DataGridTextColumn Header="Wasted" Binding="{Binding WastedText}" SortMemberPath="Wasted" Width="90" />
                                    <DataGridTextColumn Header="Other copies (can go)" Binding="{Binding Others}" Width="4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="Undo &amp; quarantine">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Delete quarantine items older than 30 days…" Command="{Binding EmptyQuarantineCommand}" CommandParameter="30" Margin="0,0,8,0" />
                                <Button Content="Empty quarantine now…" Command="{Binding EmptyQuarantineCommand}" CommandParameter="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding QuarantineText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FreedText}" Style="{StaticResource Muted}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Every clean-up is listed below and can be undone while its items are still in the Recycle Bin or quarantine. Undo never overwrites a newer file with the same name." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" Style="{StaticResource ResultsGrid}"
                              AutomationProperties.Name="Past clean-ups">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150" />
                            <DataGridTextColumn Header="Moved to" Binding="{Binding Method}" Width="110" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="What happened" Binding="{Binding Summary}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Undo" Padding="10,2" Margin="2"
                                                Command="{Binding DataContext.UndoBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Items in the selected clean-up" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding BatchItems}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Items in the selected clean-up">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Path}" Width="3*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="Now" Binding="{Binding Status}" Width="140" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Note}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding LargestHeader}">
                <DataGrid Margin="0,8,0,0" ItemsSource="{Binding LargestFiles}" Style="{StaticResource ResultsGrid}"
                          MouseDoubleClick="LargestFiles_MouseDoubleClick" AutomationProperties.Name="Largest files">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
                        <DataGridTextColumn Header="What it is" Binding="{Binding WhatItIs}" Width="2*" />
                        <DataGridTextColumn Header="Belongs to" Binding="{Binding BelongsTo}" Width="2*" />
                        <DataGridTextColumn Header="Must keep?" Binding="{Binding MustKeep}" Width="150" />
                        <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{Binding ProgramsHeader}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Everything installed on this PC, and how much of the scanned area each one takes up. Programs with no size here live outside the scanned folder." />
                    <DataGrid ItemsSource="{Binding Programs}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Installed programs">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Size here" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                            <DataGridTextColumn Header="Suggestion" Binding="{Binding Suggestion}" Width="160" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                            <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedText}" SortMemberPath="LastUsed" Width="170" />
                            <DataGridTextColumn Header="Times used" Binding="{Binding TimesUsedText}" SortMemberPath="TimesUsed" Width="85" />
                            <DataGridTextColumn Header="Time in use" Binding="{Binding TimeInUseText}" SortMemberPath="HoursInUse" Width="95" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledText}" SortMemberPath="Installed" Width="100" />
                            <DataGridTextColumn Header="Found via" Binding="{Binding Source}" Width="140" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="File types">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="By kind" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Categories}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Space by kind of file">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90" />
                                <DataGridTemplateColumn Header="Share" Width="90" SortMemberPath="Percent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Height="4" Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="90" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="8,2,8,6" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="By file extension" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Extensions}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Space by file extension">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="90" />
                                <DataGridTextColumn Header="What it is" Binding="{Binding Label}" Width="2*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90" />
                                <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="Opens with" Binding="{Binding OpensWith}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Usage">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Where PuterScanny looked for signs of use. Usage history only covers your own account, and Windows forgets older records over time, so 'no record' does not prove something was never used." />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UsageSources}" Style="{StaticResource ResultsGrid}" Margin="0,0,0,12" MaxHeight="260"
                              AutomationProperties.Name="Usage sources">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record" Binding="{Binding Source}" Width="220" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Entries" Binding="{Binding Items, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Recently used files in the scanned area" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding RecentFiles}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Recently used files"
                              MouseDoubleClick="RecentFiles_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedText}" SortMemberPath="LastUsed" Width="170" />
                            <DataGridTextColumn Header="Times used" Binding="{Binding TimesUsed}" Width="85" />
                            <DataGridTextColumn Header="What it is" Binding="{Binding WhatItIs}" Width="*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Must keep">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="What Windows and your programs depend on. Anything here is never suggested for deletion, whatever else is true about it." />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProtectionSummary}" Style="{StaticResource ResultsGrid}" Margin="0,0,0,12"
                              AutomationProperties.Name="Protection summary" MaxHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="200" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="100" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="100" />
                            <DataGridTextColumn Header="What it means" Binding="{Binding Meaning}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding ReferencesNote}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding References}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Dependencies">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Because of" Binding="{Binding Kind}" Width="170" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="150" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding IssuesHeader}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Everything the scan could not fully look inside, so nothing is silently missed. Links are not followed on purpose, so files are never counted twice." />
                    <DataGrid ItemsSource="{Binding Issues}" Style="{StaticResource ResultsGrid}" AutomationProperties.Name="Skipped and issues">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="What happened" Binding="{Binding Kind}" Width="160" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Empty state -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDA2;" FontSize="48" HorizontalAlignment="Center"
                       Style="{StaticResource Muted}" />
            <TextBlock Text="No scan yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                       Text="Pick a drive or folder above and press Scan. Nothing is changed or deleted." />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12"
                   Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
